FROM python:3.11-slim

WORKDIR /app

COPY requirements-demo.txt ./
RUN pip install --no-cache-dir -r requirements-demo.txt

COPY db.py config.py demo_chat.py unified_app.py ./
COPY team_memory.py ./
COPY mentor_intelligence.py knowledge_sync.py ./
COPY routes/ ./routes/
COPY frontend/ ./frontend/
COPY mock_corporate_docs/ ./mock_corporate_docs/
COPY knowledge/ ./knowledge/
ENV DOC_SYNC_AUTO=1

ENV AI_MODE=demo
EXPOSE 5001
CMD ["python", "unified_app.py"]
